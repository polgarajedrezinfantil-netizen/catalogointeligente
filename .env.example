# =====================================================================
#  MyelPlay Agentes (mamielina) — Plantilla de variables de entorno
#  Copia este archivo como .env.local y rellena tus llaves.
#  Las mismas variables deben configurarse en Vercel para producción.
#
#  IMPORTANTE (multi-tienda): estas variables son GLOBALES del SaaS (una
#  sola vez para todas las tiendas). Lo que es POR TIENDA (marca/voz del
#  agente, canales de Meta, y las credenciales de Mercado Pago de cada
#  cliente) NO va aquí: vive cifrado/aislado en la base de datos
#  (agente_config, agente_canales, agente_secretos).
# =====================================================================

# --- Supabase (OBLIGATORIO) ------------------------------------------
# app.supabase.com -> tu proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública del sitio (OBLIGATORIO en prod) ---------------------
# Base para redirects OAuth, back_urls y notification_url de los webhooks.
# En local: http://localhost:3000  ·  En prod: https://tu-dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic / Claude (OBLIGATORIO: agente, visión y PDF) ----------
ANTHROPIC_API_KEY=

# --- Voyage AI (RAG del agente: embeddings de catálogo) --------------
# Sin esta llave el agente cae a búsqueda por palabra clave (funciona,
# pero menos preciso). Anthropic no ofrece embeddings, por eso Voyage.
VOYAGE_API_KEY=

# --- Meta / WhatsApp · Messenger · Instagram (agente por chat) -------
# Modelo "Tech Provider": UN token de socio para todo tu portafolio de
# clientes. El id de página/número de cada tienda va en la BD (agente_canales).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
WHATSAPP_TOKEN=
# Versión del Graph API (opcional; default v20.0)
META_GRAPH_API_VERSION=v20.0

# --- Mercado Pago — Marketplace / OAuth (cobros del agente) ----------
# Credenciales de TU app de Marketplace (producción). Cada cliente conecta
# SU cuenta por OAuth (un clic); su token queda cifrado por tienda en la BD.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Firma de los webhooks de pago.
MP_WEBHOOK_SECRET=
# Fallback de transición: token global de cobro. Solo se usa para las
# tiendas listadas en MP_FALLBACK_TIENDAS (mientras conectan su propia MP).
MP_ACCESS_TOKEN=
# IDs de tienda (uuid, separadas por coma) autorizadas a usar el token global.
# Vacío = toda tienda DEBE conectar su propia cuenta de Mercado Pago.
MP_FALLBACK_TIENDAS=

# --- Mercado Pago — Suscripciones del SaaS (mensualidad de tiendas) ---
# Token de producción de TU app de Suscripciones (el dinero entra a TU
# cuenta MP). Distinta de la app de Marketplace de arriba. Sin este token
# el trial y el cron funcionan; solo no se pueden generar links de cobro.
MP_SAAS_ACCESS_TOKEN=

# --- SerpAPI (panel: precios de referencia para reventa) -------------
SERPAPI_KEY=

# --- Correo a clientes — Resend (opcional) ---------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Seguridad interna -----------------------------------------------
# Cifra los secretos por tienda (tokens MP) y firma el state del OAuth.
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# Autoriza los endpoints de cron/tareas internas. openssl rand -hex 16
CRON_SECRET=
