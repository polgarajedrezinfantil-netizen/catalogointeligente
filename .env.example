# =====================================================================
#  MAMIELINA — Plantilla de variables de entorno
#  Copia este archivo como .env.local y rellena tus llaves.
#  Las mismas variables deben configurarse en Vercel para producción.
# =====================================================================

# --- Supabase (OBLIGATORIO) ------------------------------------------
# app.supabase.com -> tu proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic / Claude (OBLIGATORIO para IA y PDF) ------------------
ANTHROPIC_API_KEY=

# --- SerpAPI o Rainforest (Fase 6: precios reales) -------------------
SERPAPI_KEY=
# RAINFOREST_API_KEY=

# --- Mercado Pago (Fase 8: cobros) -----------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Banco / Open Banking — Belvo (Fase 8, opcional) -----------------
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox

# --- Correo a clientes — Resend (opcional) ---------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp Business API (opcional; default: links wa.me) ----------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# --- Seguridad interna -----------------------------------------------
# openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# openssl rand -hex 16
CRON_SECRET=
